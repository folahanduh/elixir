# Copy this file to .env and fill in what you use. Leave blank to skip.

# Tweets (pick one, or use the free browser bridge)
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=

# Live streams: real-time speech-to-text (https://deepgram.com, new accounts get free credit)
DEEPGRAM_API_KEY=
# Live streams: Claude rates what's funny or meme-worthy (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# KOL wallet tracker: a Solana RPC with websockets (e.g. Helius free tier:
# wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY). The HTTP URL is derived from it if left blank.
SOLANA_WS_URL=
SOLANA_RPC_URL=

# Phone pings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# PORT=8787
