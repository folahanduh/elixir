# Easiest: add keys in the app (sidebar → API keys). This file is the same thing by hand:
# copy it to .env and fill in what you use. Everything is optional.

# Live streams from a link: real-time speech-to-text (https://deepgram.com, new accounts get free credit)
DEEPGRAM_API_KEY=
# Claude rates what's funny / meme-worthy and suggests tickers & images (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# KOL wallets + rug checks. Without this, Elixir uses Solana's free public RPC (works, but slower).
# A free Helius key is faster: wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=
# Only if your provider's HTTP URL isn't the websocket URL with https://
SOLANA_RPC_URL=

# Tweets by API (optional: the free X browser bridge works without a key)
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=

# Pings (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# PORT=8787
